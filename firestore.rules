rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'password'; }
  function ob(uid,id) { return /databases/$(database)/documents/forestDevUsers/$(uid)/observations/$(id); }
  function ph(uid,id) { return /databases/$(database)/documents/forestDevUsers/$(uid)/photos/$(id); }
  function validAI(data) { return !('aiSelection' in data) || (data.aiSelection is map && data.aiSelection.keys().hasAll(['provider','scientificName','commonName','score','selectedAt']) && data.aiSelection.keys().hasOnly(['provider','scientificName','commonName','score','selectedAt']) && data.aiSelection.provider=='plantnet' && data.aiSelection.scientificName is string && data.aiSelection.scientificName.size()>0 && data.aiSelection.scientificName.size()<=200 && data.aiSelection.commonName is string && data.aiSelection.commonName.size()<=200 && (data.aiSelection.score==null || (data.aiSelection.score is number && data.aiSelection.score>=0 && data.aiSelection.score<=1)) && data.aiSelection.selectedAt is int && data.aiSelection.selectedAt>0); }
  function valid(data,uid) {
   return data.keys().hasAll(['ownerId','schemaVersion','revision','shareStatus','speciesId','observedAt','name','description','centerName','createdAt','updatedAt','location','locationSource'])
    && data.keys().hasOnly(['ownerId','schemaVersion','revision','shareStatus','speciesId','observedAt','name','description','centerName','createdAt','updatedAt','location','locationSource','aiSelection','centerId'])
    && validAI(data)
    && (!('centerId' in data) || (data.centerId is string && data.centerId.matches('[^/]{1,80}')))
    && data.ownerId == uid && data.schemaVersion == 3 && data.shareStatus == 'private' && data.speciesId == null && data.observedAt == null
    && data.name is string && data.name.size()>0 && data.name.size()<=80
    && data.centerName is string && data.centerName.size()>0 && data.centerName.size()<=80
    && data.description is string && data.description.size()<=1000
    && data.createdAt is int && data.createdAt>0 && data.updatedAt is int && data.updatedAt>=data.createdAt
    && data.revision is int && data.revision>=1
    && data.locationSource in ['gps','map','center_only','legacy_unspecified']
    && ((data.location == null && data.locationSource == 'center_only') ||
      (data.location is map && data.location.keys().hasAll(['lat','lng']) && data.location.keys().hasOnly(['lat','lng'])
       && data.location.lat is number && data.location.lat>=-90 && data.location.lat<=90
       && data.location.lng is number && data.location.lng>=-180 && data.location.lng<=180 && data.locationSource != 'center_only'));
  }
  match /forestDevUsers/{uid}/observations/{id} {
   allow read: if owner(uid);
   allow create: if owner(uid) && id.matches('[A-Za-z0-9_-]{1,80}') && valid(request.resource.data,uid)
    && request.resource.data.revision==1 && validCenterBinding(request.resource.data) && existsAfter(ph(uid,id)) && !exists(ph(uid,id));
   allow update: if owner(uid) && valid(request.resource.data,uid)
    && request.resource.data.revision==resource.data.revision+1 && request.resource.data.updatedAt>resource.data.updatedAt
    && inactiveShareAfter(id)
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['centerId','centerName']) || validCenterBinding(request.resource.data))
    && (!('centerId' in resource.data) || ('centerId' in request.resource.data))
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','centerName','centerId','updatedAt','revision','aiSelection'])
    && (!('aiSelection' in request.resource.data) || (request.resource.data.aiSelection == resource.data.aiSelection
     && getAfter(ph(uid,id)).data.imageData == get(ph(uid,id)).data.imageData));
   allow delete: if owner(uid) && !existsAfter(ph(uid,id)) && inactiveShareAfter(id);
  }
  function validExtraPhoto(image) {
   return image is string && image.size()>26 && image.size()<=160023 && image.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
  }
  function validAdditionalPhotos(data) {
   return !('additionalImages' in data) || (data.additionalImages is list && data.additionalImages.size()<=2
    && (data.additionalImages.size()<1 || validExtraPhoto(data.additionalImages[0]))
    && (data.additionalImages.size()<2 || validExtraPhoto(data.additionalImages[1])));
  }
  match /forestDevUsers/{uid}/photos/{id} {
   allow read: if owner(uid) && exists(ob(uid,id));
   allow create: if owner(uid) && id.matches('[A-Za-z0-9_-]{1,80}') && !exists(ob(uid,id)) && existsAfter(ob(uid,id))
    && request.resource.data.keys().hasAll(['ownerId','schemaVersion','imageData'])
    && request.resource.data.keys().hasOnly(['ownerId','schemaVersion','imageData','additionalImages'])
    && validAdditionalPhotos(request.resource.data)
    && request.resource.data.ownerId==uid && request.resource.data.schemaVersion==3
    && request.resource.data.imageData is string && request.resource.data.imageData.size()>26 && request.resource.data.imageData.size()<=160023
    && request.resource.data.imageData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
   allow update: if owner(uid) && exists(ob(uid,id)) && existsAfter(ob(uid,id))
    && request.resource.data.keys().hasAll(['ownerId','schemaVersion','imageData','lastEditId'])
    && request.resource.data.keys().hasOnly(['ownerId','schemaVersion','imageData','additionalImages','lastEditId'])
    && request.resource.data.ownerId==uid && request.resource.data.schemaVersion==3
    && validExtraPhoto(request.resource.data.imageData) && validAdditionalPhotos(request.resource.data)
    && request.resource.data.lastEditId is string && request.resource.data.lastEditId.matches('[A-Za-z0-9_-]{1,80}')
    && (!('lastEditId' in resource.data) || request.resource.data.lastEditId != resource.data.lastEditId)
    && getAfter(ob(uid,id)).data.revision == get(ob(uid,id)).data.revision+1
    && inactiveShareAfter(id)
    && (request.resource.data.imageData == resource.data.imageData || !('aiSelection' in getAfter(ob(uid,id)).data));
   allow delete: if owner(uid) && !existsAfter(ob(uid,id));
  }
  function sr(id) { return /databases/$(database)/documents/forestShareRequests/$(id); }
  function pub(id) { return /databases/$(database)/documents/forestPublicObservations/$(id); }
  function center(id) { return /databases/$(database)/documents/forestCenters/$(id); }
  function activeCenter(id) { return exists(center(id)) && get(center(id)).data.active == true; }
  function validCenterBinding(data) {
   return !('centerId' in data) || (activeCenter(data.centerId) && data.centerName == get(center(data.centerId)).data.name);
  }
  function reviewer(id) { return request.auth != null && exists(/databases/$(database)/documents/forestReviewerGrants/$(request.auth.uid)/centers/$(id)) && get(/databases/$(database)/documents/forestReviewerGrants/$(request.auth.uid)/centers/$(id)).data.active == true; }
  function inactiveShareAfter(id) { return !existsAfter(pub(id)) && (!existsAfter(sr(id)) || getAfter(sr(id)).data.status == 'withdrawn'); }
  function shareOwner(data) { return request.auth != null && request.auth.uid == data.ownerId; }
  function validRequest(data,id) {
   return data.keys().hasAll(['ownerId','observationId','centerId','centerName','name','publicNote','imageData','originalRevision','submittedAt','status','reviewReason','reviewedAt','reviewedBy','reviewId'])
    && data.keys().hasOnly(['ownerId','observationId','centerId','centerName','name','publicNote','imageData','originalRevision','submittedAt','status','reviewReason','reviewedAt','reviewedBy','reviewId','additionalImages','selectedPhotoIndexes','submissionId'])
    && id.matches('[A-Za-z0-9_-]{1,80}') && data.observationId == id
    && data.ownerId is string && data.centerId is string && data.centerId.size()>0 && data.centerId.size()<=80
    && data.publicNote is string && data.publicNote.size()<=1000
    && data.name is string && data.name.size()>0 && data.name.size()<=80
    && data.originalRevision is int && data.originalRevision>=1
    && validExtraPhoto(data.imageData) && validAdditionalPhotos(data)
    && (!('submissionId' in data) || (data.submissionId is string && data.submissionId.matches('[A-Za-z0-9_-]{1,80}')));
  }
  function sharedExtras(data) { return ('additionalImages' in data) ? data.additionalImages : []; }
  function privatePhoto(data,index) {
   let photo = get(ph(data.ownerId,data.observationId)).data;
   return index==0 ? photo.imageData : (('additionalImages' in photo) && photo.additionalImages.size()>=index ? photo.additionalImages[index-1] : null);
  }
  function selectedPhotoMatches(data) {
   return !('selectedPhotoIndexes' in data)
    ? (data.imageData==privatePhoto(data,0) && !('additionalImages' in data))
    : (data.selectedPhotoIndexes is list && data.selectedPhotoIndexes.size()>=1 && data.selectedPhotoIndexes.size()<=3
      && sharedExtras(data).size()==data.selectedPhotoIndexes.size()-1
      && data.selectedPhotoIndexes[0] is int && data.selectedPhotoIndexes[0]>=0 && data.selectedPhotoIndexes[0]<=2
      && data.imageData==privatePhoto(data,data.selectedPhotoIndexes[0])
      && (data.selectedPhotoIndexes.size()<2 || (data.selectedPhotoIndexes[1] is int && data.selectedPhotoIndexes[1]>data.selectedPhotoIndexes[0] && data.selectedPhotoIndexes[1]<=2 && data.additionalImages[0]==privatePhoto(data,data.selectedPhotoIndexes[1])))
      && (data.selectedPhotoIndexes.size()<3 || (data.selectedPhotoIndexes[2] is int && data.selectedPhotoIndexes[2]>data.selectedPhotoIndexes[1] && data.selectedPhotoIndexes[2]<=2 && data.additionalImages[1]==privatePhoto(data,data.selectedPhotoIndexes[2]))));
  }
  function validSubmission(data,id) {
   return shareOwner(data) && validRequest(data,id) && activeCenter(data.centerId)
    && (!('centerId' in get(ob(data.ownerId,id)).data) || data.centerId == get(ob(data.ownerId,id)).data.centerId)
    && data.centerName == get(center(data.centerId)).data.name
    && data.name == get(ob(data.ownerId,id)).data.name && data.originalRevision == get(ob(data.ownerId,id)).data.revision
    && selectedPhotoMatches(data)
    && data.submittedAt == request.time && data.status == 'pending'
    && data.reviewReason == '' && data.reviewedAt == null && data.reviewedBy == null && data.reviewId == null
    && !existsAfter(pub(id));
  }
  function validReview(data,old,id) {
   return old.status == 'pending' && reviewer(old.centerId) && activeCenter(old.centerId)
    && old.originalRevision == get(ob(old.ownerId,id)).data.revision
    && data.diff(old).affectedKeys().hasOnly(['status','reviewReason','reviewedAt','reviewedBy','reviewId'])
    && data.status in ['approved','rejected'] && data.reviewReason is string && data.reviewReason.size()>0 && data.reviewReason.size()<=500
    && data.reviewedAt == request.time && data.reviewedBy == request.auth.uid && data.reviewId is string
    && !exists(/databases/$(database)/documents/forestShareRequests/$(id)/reviews/$(data.reviewId))
    && existsAfter(/databases/$(database)/documents/forestShareRequests/$(id)/reviews/$(data.reviewId))
    && getAfter(/databases/$(database)/documents/forestShareRequests/$(id)/reviews/$(data.reviewId)).data.reviewedAt == request.time
    && ((data.status == 'approved' && existsAfter(pub(id))) || (data.status == 'rejected' && !existsAfter(pub(id))));
  }
  match /forestCenters/{id} {
   allow read: if resource.data.active == true;
   allow write: if false;
  }
  match /forestCenters/{centerId}/treePlaces/{treeId} {
   function validPlace() {
    let d=request.resource.data;
    return d.keys().hasAll(['label','coordinates','revision','updatedAt']) && d.keys().hasOnly(['label','coordinates','revision','updatedAt'])
     && treeId in ['hinoki','galcham-oak','japanese-maple']
     && d.label is string && d.label.size()>0 && d.label.size()<=160
     && d.revision is int && d.revision>=1 && d.updatedAt==request.time
     && (d.coordinates==null || (d.coordinates is map && d.coordinates.keys().hasAll(['lat','lng']) && d.coordinates.keys().hasOnly(['lat','lng']) && d.coordinates.lat is number && d.coordinates.lat>=-90 && d.coordinates.lat<=90 && d.coordinates.lng is number && d.coordinates.lng>=-180 && d.coordinates.lng<=180));
   }
   allow read: if activeCenter(centerId);
   allow create: if activeCenter(centerId) && reviewer(centerId) && owner(request.auth.uid) && validPlace() && request.resource.data.revision==1;
   allow update: if activeCenter(centerId) && reviewer(centerId) && owner(request.auth.uid) && validPlace() && request.resource.data.revision==resource.data.revision+1;
   allow delete: if false;
  }
  match /forestReviewerGrants/{uid}/centers/{id} {
   allow read: if owner(uid);
   allow write: if false;
  }
  match /forestShareRequests/{id} {
   allow get: if (request.auth != null && !exists(sr(id)) && exists(ob(request.auth.uid,id))) || shareOwner(resource.data) || (resource.data.status != 'withdrawn' && reviewer(resource.data.centerId));
   allow list: if shareOwner(resource.data) || (resource.data.status != 'withdrawn' && reviewer(resource.data.centerId));
   allow create: if validSubmission(request.resource.data,id);
   allow update: if
     (shareOwner(resource.data) && request.resource.data.ownerId == resource.data.ownerId && validSubmission(request.resource.data,id)
      && (!('submissionId' in request.resource.data) || !('submissionId' in resource.data) || request.resource.data.submissionId!=resource.data.submissionId))
     || (shareOwner(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'withdrawn' && !existsAfter(pub(id)))
     || validReview(request.resource.data,resource.data,id);
   allow delete: if false;
   match /reviews/{reviewId} {
    allow read: if shareOwner(get(sr(id)).data) || reviewer(get(sr(id)).data.centerId);
    allow create: if reviewer(get(sr(id)).data.centerId)
     && request.resource.data.keys().hasAll(['decision','reason','reviewerId','originalRevision','reviewedAt'])
     && request.resource.data.keys().hasOnly(['decision','reason','reviewerId','originalRevision','reviewedAt'])
     && getAfter(sr(id)).data.reviewId == reviewId && getAfter(sr(id)).data.reviewedBy == request.auth.uid
     && request.resource.data.reviewerId == request.auth.uid
     && request.resource.data.originalRevision == getAfter(sr(id)).data.originalRevision
     && request.resource.data.decision == getAfter(sr(id)).data.status
     && request.resource.data.reason == getAfter(sr(id)).data.reviewReason
     && request.resource.data.reviewedAt == request.time && getAfter(sr(id)).data.reviewedAt == request.time;
    allow update,delete: if false;
   }
  }
  match /forestPublicObservations/{id} {
   allow read: if activeCenter(resource.data.centerId);
   allow create,update: if reviewer(get(sr(id)).data.centerId) && get(sr(id)).data.status == 'pending'
    && getAfter(sr(id)).data.status == 'approved' && getAfter(sr(id)).data.reviewedBy == request.auth.uid
    && request.resource.data.keys().hasAll(['centerId','centerName','name','publicNote','imageData','institutionLocation','locationLabel','reviewScope','publishedAt'])
    && request.resource.data.keys().hasOnly(['centerId','centerName','name','publicNote','imageData','institutionLocation','locationLabel','reviewScope','publishedAt','additionalImages'])
    && request.resource.data.centerId == getAfter(sr(id)).data.centerId
    && request.resource.data.centerName == getAfter(sr(id)).data.centerName
    && request.resource.data.name == getAfter(sr(id)).data.name
    && request.resource.data.publicNote == getAfter(sr(id)).data.publicNote
    && request.resource.data.imageData == getAfter(sr(id)).data.imageData
    && sharedExtras(request.resource.data) == sharedExtras(getAfter(sr(id)).data)
    && request.resource.data.institutionLocation == get(center(request.resource.data.centerId)).data.mapCenter
    && request.resource.data.locationLabel == '기관 위치 · 관찰 지점 아님'
    && request.resource.data.reviewScope == '담당자 공유 검토 · 식물 종 확정 아님'
    && request.resource.data.publishedAt == request.time;
   allow delete: if (shareOwner(getAfter(sr(id)).data) || reviewer(getAfter(sr(id)).data.centerId)) && getAfter(sr(id)).data.status != 'approved';
  }

  // Compatibility: previous delivered app namespace; no migration/deletion.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validText(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.description is string && data.description.size() <= 10000;
    }
    function validLocation(data) {
      return !('location' in data) || (
        data.location is map
        && data.location.keys().hasAll(['lat', 'lng'])
        && data.location.keys().hasOnly(['lat', 'lng'])
        && data.location.lat is number && data.location.lng is number
        && data.location.lat >= -90 && data.location.lat <= 90
        && data.location.lng >= -180 && data.location.lng <= 180
      );
    }
    function validIdentification(data) {
      return !('identification' in data) || (
        data.identification is map
        && data.identification.keys().hasAll(['provider','scientificName','commonName','score','organ','identifiedAt'])
        && data.identification.keys().hasOnly(['provider','scientificName','commonName','score','organ','identifiedAt'])
        && data.identification.provider == 'plantnet'
        && data.identification.scientificName is string && data.identification.scientificName.size()>0 && data.identification.scientificName.size()<=200
        && data.identification.commonName is string && data.identification.commonName.size()<=200
        && data.identification.score is number && data.identification.score>=0 && data.identification.score<=1
        && data.identification.organ in ['auto','leaf','flower','fruit','bark']
        && data.identification.identifiedAt is int && data.identification.identifiedAt>0
      );
    }
    function validLegacy(data) {
      return data.keys().hasAll(['name', 'description', 'imageData', 'createdAt'])
        && data.keys().hasOnly(['name', 'description', 'imageData', 'createdAt', 'location', 'identification'])
        && validText(data)
        && data.imageData is string && data.imageData.size() > 0
        && data.imageData.size() < 1048576
        && data.imageData.matches('data:image/(jpeg|png);base64,.*')
        && data.createdAt is int && data.createdAt > 0
        && validLocation(data);
    }
    function validStorage(data, uid, plantId) {
      return data.keys().hasAll(['name', 'description', 'createdAt', 'schemaVersion', 'imagePath', 'imageType', 'imageBytes', 'imageGeneration'])
        && data.keys().hasOnly(['name', 'description', 'createdAt', 'schemaVersion', 'imagePath', 'imageType', 'imageBytes', 'imageGeneration', 'location', 'identification'])
        && validText(data) && validLocation(data)
        && data.createdAt is int && data.createdAt > 0
        && data.schemaVersion == 2
        && plantId.matches('[A-Za-z0-9_-]{1,240}')
        && data.imagePath == 'artifacts/plant-book-84803/users/' + uid + '/plants/' + plantId + '/photo.jpg'
        && data.imageGeneration is string && data.imageGeneration.matches('[0-9]{1,30}')
        && data.imageType == 'image/jpeg'
        && data.imageBytes is int && data.imageBytes > 0 && data.imageBytes <= 2097152;
    }
    function validRecord(data, uid, plantId) {
      return validIdentification(data) && (validLegacy(data) || validStorage(data, uid, plantId));
    }
    match /artifacts/plant-book-84803/users/{uid}/plants/{plantId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validRecord(request.resource.data, uid, plantId);
      allow update: if isOwner(uid)
        && validRecord(request.resource.data, uid, plantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'identification'])
        && (!('identification' in request.resource.data) || ('identification' in resource.data && request.resource.data.identification == resource.data.identification));
    }
    // Every other path is denied unless a separate explicit rule is added.
    match /{document=**} {
      allow read, write: if false;
    }

  match /{document=**} { allow read, write: if false; }
 }
}
